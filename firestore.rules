rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function emailKey() { return request.auth.token.email.lower(); }
    function indexDoc() { return get(/databases/$(database)/documents/emailIndex/$(emailKey())); }
    function rosterDoc() { return get(/databases/$(database)/documents/roster/$(indexDoc().data.studentId)); }
    function primaryAdmin() { return signedIn() && (request.auth.token.email.lower() == '72019arnab@shristiacademy.edu.np' || request.auth.token.email.lower() == 'arnabkung@gmail.com'); }
    function activeMember() { return signedIn() && profile().data.status == 'active' && indexDoc().data.studentId == profile().data.id; }
    function admin() { return primaryAdmin() || (activeMember() && profile().data.role == 'admin'); }

    function hubStateExists() { return exists(/databases/$(database)/documents/hubState/main); }
    function councilHubMembers() { return get(/databases/$(database)/documents/hubState/main).data.get('councilHubMembers', []); }
    function councilHubMember() { return activeMember() && hubStateExists() && profile().data.id in councilHubMembers(); }
    function councilMessageKeys() {
      return ['id', 'room', 'authorId', 'authorName', 'authorRole', 'authorTitle', 'authorUid', 'body', 'timestamp', 'removed'];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && (primaryAdmin() || (
        request.auth.uid == uid
        && indexDoc().data.studentId == request.resource.data.id
        && indexDoc().data.role == request.resource.data.role
        && request.resource.data.status == 'active'
        && request.resource.data.googleEmail == request.auth.token.email.lower()
        && request.resource.data.name == rosterDoc().data.name
        && request.resource.data.email == rosterDoc().data.email
        && request.resource.data.house == rosterDoc().data.house
        && request.resource.data.grade == rosterDoc().data.grade
      ));
      allow update: if signedIn() && (primaryAdmin() || (
        request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          || (
            request.resource.data.id == resource.data.id
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.status == 'active'
          )
        )
      ));
      allow delete: if false;
    }

    match /emailIndex/{emailId} {
      allow read: if signedIn() && (emailId == emailKey() || admin());
      allow write: if primaryAdmin();
    }

    match /roster/{studentId} {
      allow read: if admin() || (signedIn() && indexDoc().data.studentId == studentId);
      allow write: if primaryAdmin();
    }

    match /hubState/main {
      allow read: if admin() || activeMember();
      allow create, update: if admin()
        && (!('councilHubMembers' in request.resource.data) || (request.resource.data.councilHubMembers is list
        && request.resource.data.councilHubMembers.size() <= 1000));
      allow delete: if false;
    }

    match /hubChat/council/messages/{messageId} {
      allow read: if councilHubMember();
      allow create: if councilHubMember()
        && request.resource.data.keys().hasOnly(councilMessageKeys())
        && request.resource.data.id == messageId
        && request.resource.data.room == 'council'
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorId == profile().data.id
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1500
        && request.resource.data.timestamp is number
        && request.resource.data.removed == false;
      allow update: if councilHubMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'body'])
        && request.resource.data.removed == true
        && request.resource.data.body == ''
        && (admin() || resource.data.authorId == profile().data.id);
      allow delete: if admin();
    }

    match /userActivity/{uid} {
      allow read, create, update: if activeMember() && request.auth.uid == uid;
      allow read: if admin();
      allow delete: if false;
    }

    match /inbox/{uid}/items/{itemId} {
      allow read, update: if activeMember() && request.auth.uid == uid;
      allow create: if admin();
      allow delete: if admin() || (activeMember() && request.auth.uid == uid);
    }

    match /deviceTokens/{tokenId} {
      allow create, update: if request.resource.data.token is string
        && request.resource.data.studentId is string;
      allow read: if admin();
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /onlineDevices/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
        && request.resource.data.model is string;
      allow delete: if request.auth != null || request.time != null;
    }

    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /pushHistory/{pushId} {
      allow read, create: if admin();
      allow update, delete: if false;
    }

    match /publicConfig/messaging {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['vapidKey', 'updatedAt'])
        && request.resource.data.vapidKey is string;
      allow delete: if admin();
    }

    match /publicConfig/sheets {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['apiUrl', 'token', 'houseMap', 'sections', 'pollSeconds', 'updatedAt'])
        && request.resource.data.apiUrl is string
        && request.resource.data.apiUrl.matches('^https://.*')
        && request.resource.data.apiUrl.size() <= 500
        && (!('token' in request.resource.data) || (request.resource.data.token is string && request.resource.data.token.size() <= 200))
        && (!('pollSeconds' in request.resource.data) || request.resource.data.pollSeconds == null
            || (request.resource.data.pollSeconds is int && request.resource.data.pollSeconds >= 15 && request.resource.data.pollSeconds <= 3600))
        && (!('sections' in request.resource.data) || request.resource.data.sections is map);
      allow delete: if admin();
    }

    match /__connection_test__/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}